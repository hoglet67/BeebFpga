// System Clock (27MHz)
// IO_LOC  "sys_clk" 4;  // 27MHZ Crystal Oscillator
IO_LOC  "sys_clk" 10; // MS5351 CLK 0 which must be set to 27MHz
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;

IO_LOC  "spdif_clk" 11; // MS5351 CLK 1 which must be set to 6.144MHz
IO_PORT "spdif_clk" IO_TYPE=LVCMOS33;

IO_LOC  "chroma_clk" 13; // MS5351 CLK 2 which must be set to 17.734475MHz
IO_PORT "chroma_clk" IO_TYPE=LVCMOS33;


// Button 1
IO_LOC  "btn1" 88;
IO_PORT "btn1" PULL_MODE=DOWN;

// Button 2
IO_LOC  "btn2" 87;
IO_PORT "btn2" PULL_MODE=DOWN;

// Keyboard
IO_LOC  "ps2_clk" 27;
IO_PORT "ps2_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "ps2_data" 28;
IO_PORT "ps2_data" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Mouse
IO_LOC  "ps2_mouse_clk" 25;
IO_PORT "ps2_mouse_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "ps2_mouse_data" 26;
IO_PORT "ps2_mouse_data" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// I2S Audio
IO_LOC "i2s_bclk" 56;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "i2s_lrclk" 55;
IO_PORT "i2s_lrclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "i2s_din" 54;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "pa_en" 51;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// Audio SPDIF Output
IO_LOC "audio_spdif" 86;
IO_PORT "audio_spdif" IO_TYPE=LVCMOS33;


// SD Card
IO_LOC  "tf_cs" 81;
IO_PORT "tf_cs" IO_TYPE=LVCMOS33;
IO_LOC  "tf_mosi" 82;
IO_PORT "tf_mosi" IO_TYPE=LVCMOS33;
IO_LOC  "tf_sclk" 83;
IO_PORT "tf_sclk" IO_TYPE=LVCMOS33;
IO_LOC  "tf_miso" 84;
IO_PORT "tf_miso" IO_TYPE=LVCMOS33;

// UART
IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC  "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;

// LEDs
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33;
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33;

// WS2812 LED
IO_LOC  "ws2812_din" 79
IO_PORT "ws2812_din" IO_TYPE=LVCMOS33;

// SPI Flash
IO_LOC  "flash_cs" 60;
IO_PORT "flash_cs" IO_TYPE=LVCMOS33;
IO_LOC  "flash_ck" 59;
IO_PORT "flash_ck" IO_TYPE=LVCMOS33;
IO_LOC  "flash_si" 61;
IO_PORT "flash_si" IO_TYPE=LVCMOS33;
IO_LOC  "flash_so" 62;
IO_PORT "flash_so" IO_TYPE=LVCMOS33 PULL_MODE=UP;


// 1 bit video 

IO_LOC "vid_r_o" 73;
IO_PORT "vid_r_o" IO_TYPE=LVCMOS33 DRIVE=24;

IO_LOC "vid_g_o" 74;
IO_PORT "vid_g_o" IO_TYPE=LVCMOS33 DRIVE=24;

IO_LOC "vid_b_o" 75;
IO_PORT "vid_b_o" IO_TYPE=LVCMOS33 DRIVE=24;

IO_LOC "vid_cs_o" 85;
IO_PORT "vid_cs_o" IO_TYPE=LVCMOS33 DRIVE=24;

IO_LOC "vid_chr_o" 77;
IO_PORT "vid_chr_o" IO_TYPE=LVCMOS33 DRIVE=24;

IO_LOC "car_ry_o" 29;
IO_PORT "car_ry_o" IO_TYPE=LVCMOS33 DRIVE=24;
